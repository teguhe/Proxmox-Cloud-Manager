# Server & Environment
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://proxmox_mgr:proxmox_mgr_secret@localhost:5433/proxmox_cloud_manager
POSTGRES_PORT=5433
POSTGRES_USER=proxmox_mgr
POSTGRES_PASSWORD=proxmox_mgr_secret
POSTGRES_DB=proxmox_cloud_manager

# Security (AES-256-GCM 32-byte hex key: openssl rand -hex 32)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Super Admin Bootstrap
PROTECTED_SUPER_ADMIN_EMAIL=teguhe@gmail.com

# Firebase Admin SDK (Backend)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Firebase Client SDK (Frontend Vite)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=1:000000000000:web:000000000000
VITE_API_BASE_URL=/api/v1
